<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════════════
     Partner Contract — Form View
════════════════════════════════════════════════════════════════ -->
<record id="view_partner_contract_form" model="ir.ui.view">
    <field name="name">partner.contract.form</field>
    <field name="model">partner.contract</field>
    <field name="arch" type="xml">
        <form string="Partner Contract">
            <header>
                <button name="action_generate_installments"
                        string="Generate Installments"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>
                <button name="action_activate"
                        string="Activate"
                        type="object"
                        class="btn-success"
                        invisible="state != 'draft'"/>
                <button name="action_mark_done"
                        string="Mark Done"
                        type="object"
                        invisible="state != 'active'"/>
                <button name="action_renew_contract"
                        string="Renew Now"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ('active', 'done') or renewed_contract_id"/>
                <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state in ('renewed', 'done', 'cancelled')"/>
                <button name="action_reset_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ('cancelled',)"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,active,renewed,done"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                </div>

                <group>
                    <group string="Contract Details">
                        <field name="partner_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="contract_amount"/>
                        <field name="currency_id" groups="base.group_multi_currency"/>
                    </group>
                    <group string="Payment Settings">
                        <field name="payment_periods"/>
                        <field name="auto_renew"/>
                        <field name="previous_contract_id" readonly="1" invisible="not previous_contract_id"/>
                        <field name="renewed_contract_id" readonly="1" invisible="not renewed_contract_id"/>
                        <field name="installment_count" invisible="1"/>
                        <field name="amount_paid" readonly="1"/>
                        <field name="amount_remaining" readonly="1"
                               decoration-danger="amount_remaining > 0"/>
                        <field name="next_payment_date" readonly="1"/>
                    </group>
                </group>

                <!-- Installment schedule table — shown once payment_periods is set -->
                <notebook>
                    <page string="Installment Schedule" name="installments"
                          invisible="not payment_periods">
                        <div class="alert alert-info" role="alert"
                             invisible="installment_count != 0 or not payment_periods">
                            Click <strong>Generate Installments</strong> to create the payment schedule,
                            or change the fields above — the schedule will auto-preview below.
                        </div>
                        <field name="installment_ids"
                               context="{'default_contract_id': id, 'default_partner_id': partner_id}">
                            <list string="Installments" editable="bottom"
                                  decoration-danger="state == 'overdue'"
                                  decoration-success="state == 'paid'"
                                  decoration-muted="state == 'waived'">
                                <field name="sequence" string="#" width="40"/>
                                <field name="due_date"/>
                                <field name="amount_expected" string="Expected"/>
                                <field name="amount_paid" string="Paid"/>
                                <field name="amount_remaining" string="Remaining"/>
                                <field name="state" widget="badge"
                                       decoration-danger="state == 'overdue'"
                                       decoration-success="state == 'paid'"
                                       decoration-warning="state == 'partial'"
                                       decoration-info="state == 'pending'"/>
                                <field name="payment_date" string="Paid On" optional="show"/>
                                <field name="payment_reference" optional="hide"/>
                                <field name="notes" optional="hide"/>
                                <button name="action_mark_paid" string="Mark Paid"
                                        type="object" icon="fa-check"
                                        invisible="state == 'paid'"/>
                            </list>
                        </field>
                    </page>
                    <page string="Notes" name="notes_page">
                        <field name="notes" placeholder="Internal notes about this contract..."/>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     Partner Contract — Tree View
════════════════════════════════════════════════════════════════ -->
<record id="view_partner_contract_tree" model="ir.ui.view">
    <field name="name">partner.contract.tree</field>
    <field name="model">partner.contract</field>
    <field name="arch" type="xml">
        <list string="Contracts"
              decoration-danger="amount_remaining > 0 and state == 'active'"
              decoration-muted="state in ('done', 'cancelled')">
            <field name="name"/>
            <field name="partner_id"/>
            <field name="start_date"/>
            <field name="end_date"/>
            <field name="contract_amount" sum="Total"/>
            <field name="payment_periods"/>
            <field name="auto_renew" optional="hide"/>
            <field name="amount_paid" sum="Paid"/>
            <field name="amount_remaining" sum="Remaining"
                   decoration-danger="amount_remaining > 0"/>
            <field name="next_payment_date"/>
            <field name="installment_count" string="Inst."/>
            <field name="state" widget="badge"
                   decoration-success="state == 'done'"
                   decoration-info="state == 'active'"
                   decoration-muted="state in ('renewed', 'cancelled')"/>
        </list>
    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     Partner Contract — Search View
════════════════════════════════════════════════════════════════ -->
<record id="view_partner_contract_search" model="ir.ui.view">
    <field name="name">partner.contract.search</field>
    <field name="model">partner.contract</field>
    <field name="arch" type="xml">
        <search string="Search Contracts">
            <field name="name"/>
            <field name="partner_id"/>
            <filter string="Active" name="active" domain="[('state','=','active')]"/>
            <filter string="Draft"  name="draft"  domain="[('state','=','draft')]"/>
            <filter string="Done"   name="done"   domain="[('state','=','done')]"/>
            <filter string="Renewed" name="renewed" domain="[('state','=','renewed')]"/>
            <separator/>
            <filter string="Due Today" name="due_today"
                    domain="[('next_payment_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Status"   name="group_state"   context="{'group_by': 'state'}"/>
                <filter string="Payment Period" name="group_period" context="{'group_by': 'payment_periods'}"/>
        </search>
    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     Window Action — All Contracts
════════════════════════════════════════════════════════════════ -->
<record id="action_partner_contract" model="ir.actions.act_window">
    <field name="name">Customer Contracts</field>
    <field name="res_model">partner.contract</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_partner_contract_search"/>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Create your first contract</p>
        <p>Define a contract amount and payment period to auto-generate installment dates.</p>
    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     Window Action — Customers with payment due ±1 day from today
     Uses a stored computed field on res.partner for reliability.
════════════════════════════════════════════════════════════════ -->
<record id="action_partners_due_today" model="ir.actions.act_window">
    <field name="name">Payments Due Today</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('has_payment_due_near_today', '=', True)]</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No payments due today</p>
        <p>Customers with contract installments due yesterday, today, or tomorrow will appear here.</p>
    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     res.partner form — Contract page + smart button
════════════════════════════════════════════════════════════════ -->
<record id="view_partner_contract_tab" model="ir.ui.view">
    <field name="name">res.partner.contract.tab</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

        <!-- Smart button -->
        <xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_view_contracts"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="contract_count == 0">
                <div class="o_field_widget o_stat_info">
                    <span class="o_stat_value">
                        <field name="contract_count"/>
                    </span>
                    <span class="o_stat_text">Contracts</span>
                </div>
            </button>
        </xpath>

        <!-- Contract tab -->
        <xpath expr="//notebook" position="inside">
            <page string="Contracts" name="contracts_page"
                  invisible="not customer_rank">
                <field name="contract_ids"
                       context="{'default_partner_id': id}">
                    <list string="Contracts"
                          decoration-danger="amount_remaining > 0 and state == 'active'"
                          decoration-muted="state in ('done','cancelled')">
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="contract_amount"/>
                        <field name="payment_periods"/>
                        <field name="auto_renew" optional="hide"/>
                        <field name="amount_paid"/>
                        <field name="amount_remaining"
                               decoration-danger="amount_remaining > 0"/>
                        <field name="next_payment_date"/>
                        <field name="state" widget="badge"
                               decoration-success="state == 'done'"
                               decoration-info="state == 'active'"
                               decoration-muted="state in ('renewed', 'cancelled')"/>
                    </list>
                </field>
            </page>
        </xpath>

    </field>
</record>

<!-- ══════════════════════════════════════════════════════════════
     Menus
════════════════════════════════════════════════════════════════ -->

<!-- Top-level menu under Invoicing / Receivables -->
<menuitem id="menu_partner_contracts"
          name="Customer Contracts"
          parent="account.menu_finance_receivables"
          action="action_partner_contract"
          sequence="30"/>

<!-- Sub-menu: Payment Due Today (±1 day) -->
<menuitem id="menu_partners_due_today"
          name="Payments Due Today"
          parent="account.menu_finance_receivables"
          action="action_partners_due_today"
          sequence="31"/>

</odoo>
