<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ── Add smart buttons to partner form ── -->
<record id="view_partner_payment_profile_buttons" model="ir.ui.view">
    <field name="name">res.partner.payment.profile.buttons</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='vat']" position="after">
            <field name="x_iban"/>
        </xpath>

        <!-- Smart buttons -->
        <xpath expr="//div[@name='button_box']" position="inside">

            <button name="action_view_payment_plans"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar-check-o"
                    invisible="payment_plan_count == 0">
                <div class="o_field_widget o_stat_info">
                    <span class="o_stat_value">
                        <field name="payment_plan_count"/>
                    </span>
                    <span class="o_stat_text">Payment Plans</span>
                </div>
            </button>

            <button name="action_view_overdue_installments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exclamation-triangle"
                    invisible="overdue_installment_count == 0">
                <div class="o_field_widget o_stat_info">
                    <span class="o_stat_value" style="color: #dc2626;">
                        <field name="overdue_installment_count"/>
                    </span>
                    <span class="o_stat_text">Overdue</span>
                </div>
            </button>

        </xpath>

        <!-- Payment Profile tab — inserted after the Sales &amp; Purchase tab -->
        <xpath expr="//notebook" position="inside">
            <page string="Payment Profile" name="payment_profile"
                  invisible="not customer_rank">
                <field name="customer_rank" invisible="1"/>

                <!-- Summary row -->
                <group string="Default Payment Behaviour">
                    <group>
                        <field name="default_payment_type"/>
                        <field name="default_fixed_day"
                               invisible="default_payment_type != 'fixed_day'"
                               string="Pays on day"/>
                    </group>
                    <group>
                        <field name="total_overdue_amount"
                               string="Total Overdue Amount"
                               readonly="1"
                               decoration-danger="total_overdue_amount > 0"/>
                        <field name="active_plan_count"
                               string="Active Plans"
                               readonly="1"/>
                    </group>
                </group>

                <field name="payment_notes"
                       placeholder="Describe how this client pays — e.g. 'Always pays on the 10th, sometimes 2-3 days late', 'Pays in 3 instalments', etc."/>

                <separator string="Payment Plans"/>

                <!-- Inline list of plans directly on the partner tab -->
                <field name="payment_plan_count" invisible="1"/>
                <field name="overdue_installment_count" invisible="1"/>

                <div class="o_field_widget">
                    <button name="action_view_payment_plans"
                            type="object"
                            string="Open Full Payment Plans View"
                            class="btn-secondary btn-sm"
                            icon="fa-external-link"/>
                </div>

                <!-- Embedded readonly plan list for quick reference -->
                <div class="mt-2">
                    <field name="payment_plan_count" invisible="1"/>
                </div>

                <!-- Overdue banner -->
                <div class="alert alert-danger"
                     role="alert"
                     invisible="overdue_installment_count == 0">
                    <strong>⚠ Overdue Installments:</strong>
                    <field name="overdue_installment_count" readonly="1"/>
                    installments are overdue —
                    <button name="action_view_overdue_installments"
                            type="object"
                            string="View Details"
                            class="btn-link p-0"/>
                </div>

            </page>
        </xpath>

    </field>
</record>

<!-- ── Partner list — add overdue badge column ── -->
<record id="view_partner_payment_overdue_list" model="ir.ui.view">
    <field name="name">res.partner.payment.overdue.list</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//list" position="attributes">
            <attribute name="decoration-danger">overdue_installment_count > 0</attribute>
        </xpath>
        <xpath expr="//field[@name='phone']" position="after">
            <field name="overdue_installment_count"
                   string="Overdue"
                   optional="show"
                   decoration-danger="overdue_installment_count > 0"
                   decoration-success="overdue_installment_count == 0"/>
            <field name="total_overdue_amount"
                   string="Overdue Amt"
                   optional="show"
                   decoration-danger="total_overdue_amount > 0"/>
        </xpath>
    </field>
</record>

</odoo>
