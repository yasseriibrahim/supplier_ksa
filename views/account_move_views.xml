<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_search_invoice_region" model="ir.ui.view">
        <field name="name">account.move.search.invoice.region</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">

            <!-- Add field -->
            <xpath expr="//search" position="inside">
                <field name="invoice_region"/>
            </xpath>

            <!-- Add filters -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="region_dm" string="الدمام"
                        domain="[('invoice_region','=','الدمام')]"/>
                <filter name="region_ry" string="الرياض"
                        domain="[('invoice_region','=','الرياض')]"/>
                <filter name="region_jd" string="جده"
                        domain="[('invoice_region','=','جده')]"/>
            </xpath>

            <!-- Group By -->
            <xpath expr="//search" position="inside">
                <filter name="group_by_region"
                        string="Region / المنطقة"
                        context="{'group_by': 'invoice_region'}"/>
            </xpath>

        </field>
    </record>


    <record id="view_move_form_custom_invoice_button" model="ir.ui.view">
        <field name="name">account.move.form.custom.invoice.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button name="action_view_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="picking_count == 0">
                    <field name="picking_count" widget="statinfo" string="Transfers"/>
                </button>
            </div>


            <xpath expr="//field[@name='partner_id']" position="after">
                <group>
                    <field name="agent_id" string="Agent Name"/>
                    <field name="branch_name" string="Branch Name"/>
                    <field name="collect_type" string="Payment Way"/>
                    <field name="invoice_region"/>
                    <field name="driver_name"/>
                    <field name="location_id"
                           options="{'no_create': True}"
                           readonly="state != 'draft'"
                           invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="amount_discount" widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1"
                       invisible="amount_discount == 0"
                       string="Discount"/>
            </xpath>
            <xpath expr="//header/button[@name='action_invoice_sent']" position="before">
                <button
                    name="action_print_custom_invoice"
                    string="🖨 Custom Invoice"
                    type="object"
                    class="btn-primary"
                    invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund') or state == 'draft'"
                    title="Print the custom styled invoice PDF"
                />
            </xpath>


            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                   position="before">
                <field name="product_domain" column_invisible="1"/>
                <field name="line_location_id"
                       options="{'no_create': True}"
                       readonly="parent.location_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                   position="attributes">
                <attribute name="domain">product_domain</attribute>
            </xpath>


        </field>
    </record>
</odoo>

