<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_update_installment_states" model="ir.cron">
            <field name="name">Payment Profile: Auto-Update Overdue Installments</field>
            <field name="model_id" ref="model_partner_payment_installment"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_overdue_states()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="priority">100</field>
        </record>

        <record id="ir_cron_refresh_payment_due_flag" model="ir.cron">
            <field name="name">Partner Contract: Refresh Payment Due Today Flag</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_payment_due_flag()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="priority">101</field>
        </record>

        <record id="ir_cron_renew_yearly_partner_contracts" model="ir.cron">
            <field name="name">Partner Contract: Automatic Yearly Renewal</field>
            <field name="model_id" ref="model_partner_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_renew_yearly_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="priority">102</field>
        </record>
    </data>
</odoo>
