<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">


        <record id="seq_partner_payment_profile" model="ir.sequence">
            <field name="name">Partner Payment Plan</field>
            <field name="code">partner.payment.profile</field>
            <field name="prefix">PPP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_partner_contract" model="ir.sequence">
            <field name="name">Partner Contract</field>
            <field name="code">partner.contract</field>
            <field name="prefix">CON/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="seq_non_invoiced_order" model="ir.sequence">
            <field name="name">Non Invoiced Order</field>
            <field name="code">non.invoiced.order</field>
            <field name="prefix">NIO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
