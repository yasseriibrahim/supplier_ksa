<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Account Statement PDF – standalone primary variant.
        Rendered directly via ir.qweb._render(), NOT via the generic
        pdf_export_main pipeline, so it does NOT need inherit_id.
        Receives: report, options, partners, grand_total, base_url, env
    -->
    <template id="account_statement_pdf_main">
        <html>
            <head>
                <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
                <style>
                    @page {
                        margin-top: 12mm;
                        margin-bottom: 16mm;
                        margin-left: 9mm;
                        margin-right: 9mm;
                    }
                    * { box-sizing: border-box; }
                    body { font-family: Arial, sans-serif; font-size: 10pt;
                           color: #1e293b; margin: 0; padding: 0; }

                    /* ── DOC HEADER ── */
                    .as-header { width: 100%; border-collapse: collapse;
                        margin-bottom: 18px; background: #f8f8f8;
                        border: 1px solid #dde1e7; border-radius: 8px;
                        -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                    .as-header td { padding: 10px 16px; vertical-align: middle; border: none; }
                    .as-logo { width: 80px; height: 80px; object-fit: contain;
                        border-radius: 6px; border: 1px solid #e0e0e0; }
                    .as-company-name { font-size: 13pt; font-weight: 800; color: #111; }
                    .as-company-sub  { font-size: 8pt; color: #555; line-height: 1.8; }
                    .as-title-cell   { text-align: center; }
                    .as-title-en { font-size: 15pt; font-weight: 800;
                        letter-spacing: 1px; color: #111; display: block; }
                    .as-title-ar { font-size: 12pt; font-weight: 700;
                        color: #444; display: block; margin-top: 3px; }
                    .as-meta-table { border-collapse: collapse; font-size: 8.5pt;
                        margin-left: auto; }
                    .as-meta-table td { padding: 3px 7px; }
                    .as-meta-lbl { color: #555; font-weight: 600; white-space: nowrap; }
                    .as-meta-val { color: #111; font-weight: 700; }

                    /* ── CLIENT HEADER ── */
                    .as-client-header {
                        background: #1e3a5f; color: #fff;
                        padding: 9px 14px; margin-top: 18px;
                        border-radius: 6px 6px 0 0;
                        -webkit-print-color-adjust: exact; print-color-adjust: exact;
                    }
                    .as-client-name { font-size: 11pt; font-weight: 800; }

                    /* ── DATA TABLE ── */
                    .as-table { width: 100%; border-collapse: collapse;
                        font-size: 9pt; border: 1px solid #c8d3e8;
                        margin-bottom: 0; }
                    /* thead */
                    .as-table thead tr {
                        background: #2563eb;
                        -webkit-print-color-adjust: exact; print-color-adjust: exact;
                    }
                    .as-table thead th {
                        padding: 7px 8px; color: #fff; font-weight: 700;
                        font-size: 8pt; text-transform: uppercase;
                        letter-spacing: 0.4px; border-bottom: 2px solid #1e4db7;
                        white-space: nowrap; text-align: left;
                    }
                    .as-table thead th.r { text-align: right; }
                    .as-th-ar { font-size: 7pt; font-weight: 500; display: block;
                        margin-top: 1px; color: #cfe2ff;
                        text-transform: none; letter-spacing: 0; }
                    /* tbody rows */
                    .as-table tbody tr.odd  { background: #ffffff; }
                    .as-table tbody tr.even {
                        background: #eef3ff;
                        -webkit-print-color-adjust: exact; print-color-adjust: exact;
                    }
                    .as-table tbody td {
                        padding: 5px 8px; border-bottom: 1px solid #e0e6f4;
                        vertical-align: top; color: #111;
                    }
                    .as-table tbody td.r    { text-align: right; }
                    .as-table tbody td.bold { font-weight: 700; }
                    .as-table tbody td.muted{ color: #666; }
                    /* subtotal row */
                    .as-table tbody tr.subtotal {
                        background: #dbeafe;
                        -webkit-print-color-adjust: exact; print-color-adjust: exact;
                    }
                    .as-table tbody tr.subtotal td {
                        padding: 5px 8px; font-weight: 700; font-size: 9pt;
                        color: #1e3a5f; border-top: 2px solid #2563eb;
                    }

                    /* ── GRAND TOTAL ── */
                    .as-grand { width: 100%; border-collapse: collapse;
                        margin-top: 14px; border: 1px solid #1e3a5f; }
                    .as-grand td {
                        padding: 8px 10px; font-weight: 800; font-size: 10pt;
                        color: #fff; background: #1e3a5f;
                        -webkit-print-color-adjust: exact; print-color-adjust: exact;
                    }
                    .as-grand td.r { text-align: right; }

                    /* ── FOOTER ── */
                    .as-footer { margin-top: 14px; padding: 8px 14px;
                        background: #f0f4ff; border: 1px solid #dde1e7;
                        border-radius: 6px; font-size: 7.5pt; color: #444;
                        -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                    .as-footer table { width: 100%; border-collapse: collapse; }
                    .as-footer td { border: none; padding: 0 4px; }
                </style>
            </head>
            <body>

                <!-- ══ DOCUMENT HEADER ══ -->
                <table class="as-header">
                    <tr>
                        <!-- Logo -->
                        <td style="width:100px;">
                            <t t-if="env.company.logo">
                                <img t-att-src="image_data_uri(env.company.logo)"
                                     class="as-logo" alt="Logo"/>
                            </t>
                        </td>
                        <!-- Company info -->
                        <td>
                            <div class="as-company-name" t-out="env.company.name"/>
                            <t t-if="env.company.vat">
                                <div class="as-company-sub">
                                    <span style="color:#888;">VAT / الرقم الضريبي: </span>
                                    <strong t-out="env.company.vat"/>
                                </div>
                            </t>
                            <t t-if="env.company.street">
                                <div class="as-company-sub" t-out="env.company.street"/>
                            </t>
                            <t t-if="env.company.phone">
                                <div class="as-company-sub">
                                    <span style="color:#888;">Tel: </span>
                                    <t t-out="env.company.phone"/>
                                </div>
                            </t>
                        </td>
                        <!-- Title -->
                        <td class="as-title-cell">
                            <span class="as-title-en">ACCOUNT STATEMENT</span>
                            <span class="as-title-ar">كشف حساب</span>
                        </td>
                        <!-- Date range -->
                        <td style="width:210px; text-align:right;">
                            <table class="as-meta-table">
                                <t t-set="d_from" t-value="options.get('date', {}).get('date_from', '')"/>
                                <t t-set="d_to"   t-value="options.get('date', {}).get('date_to',   '')"/>
                                <t t-if="d_from">
                                    <tr>
                                        <td class="as-meta-lbl">From / من:</td>
                                        <td class="as-meta-val" t-out="d_from"/>
                                    </tr>
                                </t>
                                <t t-if="d_to">
                                    <tr>
                                        <td class="as-meta-lbl">To / إلى:</td>
                                        <td class="as-meta-val" t-out="d_to"/>
                                    </tr>
                                </t>
                                <tr>
                                    <td class="as-meta-lbl">Printed / طباعة:</td>
                                    <td class="as-meta-val"
                                        t-out="datetime.datetime.now().strftime('%Y-%m-%d %H:%M')"/>
                                </tr>
                                <t t-if="options.get('all_entries')">
                                    <tr>
                                        <td colspan="2"
                                            style="color:#c2410c;font-weight:700;font-size:8pt;">
                                            [Draft Included / يشمل المسودة]
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- ══ PARTNER SECTIONS ══
                     Each partner is one complete <table> with thead + tbody.
                     'partners' is pre-grouped in Python:
                       [{header: line_dict, rows: [line_dict, ...]}, ...]
                -->
                <t t-foreach="partners" t-as="partner">

                    <!-- Client name bar -->
                    <div class="as-client-header">
                        <span class="as-client-name"
                              t-out="partner['header'].get('name', '')"/>
                    </div>

                    <!-- One table per partner with real thead + tbody -->
                    <table class="as-table">
                        <thead>
                            <tr>
                                <th>Date<span class="as-th-ar">التاريخ</span></th>
                                <th>Reference<span class="as-th-ar">المرجع</span></th>
                                <th>Journal<span class="as-th-ar">اليومية</span></th>
                                <th>Account<span class="as-th-ar">الحساب</span></th>
                                <th class="r">Debit<span class="as-th-ar">مدين</span></th>
                                <th class="r">Credit<span class="as-th-ar">دائن</span></th>
                                <th class="r">Balance<span class="as-th-ar">الرصيد</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="partner['rows']" t-as="row">
                                <t t-set="rc"      t-value="row.get('columns', [])"/>
                                <t t-set="row_cls" t-value="'even' if row_index % 2 == 0 else 'odd'"/>
                                <t t-set="c_date"
                                   t-value="([c for c in rc if c.get('expression_label') == 'invoice_date'] or [{}])[0]"/>
                                <t t-set="c_jour"
                                   t-value="([c for c in rc if c.get('expression_label') == 'journal_code'] or [{}])[0]"/>
                                <t t-set="c_acc"
                                   t-value="([c for c in rc if c.get('expression_label') == 'account_code'] or [{}])[0]"/>
                                <t t-set="c_deb"
                                   t-value="([c for c in rc if c.get('expression_label') == 'debit']        or [{}])[0]"/>
                                <t t-set="c_crd"
                                   t-value="([c for c in rc if c.get('expression_label') == 'credit']       or [{}])[0]"/>
                                <t t-set="c_bal"
                                   t-value="([c for c in rc if c.get('expression_label') == 'balance']      or [{}])[0]"/>
                                <tr t-att-class="row_cls">
                                    <td class="muted"
                                        t-out="c_date.get('name', '') or row.get('date', '') or ''"/>
                                    <td class="bold"
                                        t-out="row.get('name', '') or ''"/>
                                    <td class="muted"
                                        t-out="c_jour.get('name', '') or ''"/>
                                    <td class="muted"
                                        t-out="c_acc.get('name', '')  or ''"/>
                                    <td class="r"
                                        t-out="c_deb.get('name', '')  or ''"/>
                                    <td class="r"
                                        t-out="c_crd.get('name', '')  or ''"/>
                                    <td class="r bold"
                                        t-out="c_bal.get('name', '')  or ''"/>
                                </tr>
                            </t>

                            <!-- Partner subtotal row -->
                            <t t-set="hc"     t-value="partner['header'].get('columns', [])"/>
                            <t t-set="h_deb"  t-value="([c for c in hc if c.get('expression_label') == 'debit']   or [{}])[0]"/>
                            <t t-set="h_crd"  t-value="([c for c in hc if c.get('expression_label') == 'credit']  or [{}])[0]"/>
                            <t t-set="h_bal"  t-value="([c for c in hc if c.get('expression_label') == 'balance'] or [{}])[0]"/>
                            <tr class="subtotal">
                                <td colspan="4">Sub-total / المجموع الفرعي</td>
                                <td class="r" t-out="h_deb.get('name', '') or ''"/>
                                <td class="r" t-out="h_crd.get('name', '') or ''"/>
                                <td class="r bold" t-out="h_bal.get('name', '') or ''"/>
                            </tr>

                        </tbody>
                    </table>

                </t>

                <!-- ══ GRAND TOTAL ══ -->
                <t t-if="grand_total">
                    <t t-set="gc"    t-value="grand_total.get('columns', [])"/>
                    <t t-set="g_deb" t-value="([c for c in gc if c.get('expression_label') == 'debit']   or [{}])[0]"/>
                    <t t-set="g_crd" t-value="([c for c in gc if c.get('expression_label') == 'credit']  or [{}])[0]"/>
                    <t t-set="g_bal" t-value="([c for c in gc if c.get('expression_label') == 'balance'] or [{}])[0]"/>
                    <table class="as-grand">
                        <tr>
                            <td colspan="4">TOTAL / الإجمالي العام</td>
                            <td class="r" t-out="g_deb.get('name', '') or ''"/>
                            <td class="r" t-out="g_crd.get('name', '') or ''"/>
                            <td class="r" t-out="g_bal.get('name', '') or ''"/>
                        </tr>
                    </table>
                </t>

                <!-- ══ DOCUMENT FOOTER ══ -->
                <div class="as-footer">
                    <table>
                        <tr>
                            <td t-out="env.company.name"/>
                            <td style="text-align:center; color:#888;">
                                Account Statement / كشف حساب
                            </td>
                            <td style="text-align:right; color:#888;"
                                t-out="datetime.datetime.now().strftime('%Y-%m-%d')"/>
                        </tr>
                    </table>
                </div>

            </body>
        </html>
    </template>

</odoo>
