<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_payment_generate_wizard_form" model="ir.ui.view">
    <field name="name">partner.payment.generate.wizard.form</field>
    <field name="model">partner.payment.generate.wizard</field>
    <field name="arch" type="xml">
        <form string="Generate Installment Lines">
            <sheet>
                <!-- Plan summary -->
                <group string="Plan Summary">
                    <group>
                        <field name="plan_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="total_amount" readonly="1"/>
                        <field name="currency_id" readonly="1"
                               groups="base.group_multi_currency"/>
                    </group>
                </group>

                <!-- Configuration -->
                <group string="Installment Configuration">
                    <group>
                        <field name="installment_count"/>
                        <field name="frequency"/>
                        <field name="custom_days"
                               invisible="frequency != 'custom'"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="bank_id" domain="[('partner_id', '=', partner_id)]"/>
                        <field name="amount_per_installment" readonly="1"/>
                        <field name="last_installment_adjustment" readonly="1"/>
                    </group>
                </group>

                <!-- Preview -->
                <separator string="Preview (will be created)"/>
                <field name="preview_line_ids" readonly="1">
                    <list>
                        <field name="sequence" string="#"/>
                        <field name="due_date"/>
                        <field name="amount_expected"/>
                    </list>
                </field>

                <div class="alert alert-warning" role="alert">
                    <strong>Note:</strong> Existing <em>pending</em> and
                    <em>overdue</em> lines will be replaced.
                    Already <em>paid</em> and <em>waived</em> lines are kept.
                </div>
            </sheet>
            <footer>
                <button name="action_generate"
                        string="Generate Lines"
                        type="object"
                        class="btn-primary"/>
                <button string="Cancel"
                        class="btn-secondary"
                        special="cancel"/>
            </footer>
        </form>
    </field>
</record>

</odoo>
